# Copie para .env.local e preencha. NUNCA comite .env.local.

# Chave da API do OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Qualquer modelo do catálogo do OpenRouter (https://openrouter.ai/models).
# Precisa suportar tool calling para a etapa de function calling.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Modelo de embedding, também via OpenRouter — a mesma chave serve.
# Trocar exige mudar vector(1536) na migration e reindexar tudo.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Usado nos headers HTTP-Referer/X-Title do OpenRouter (ranking público).
# Em produção, a URL da Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings > Data API (URL) e > API Keys (chave secreta).
SUPABASE_URL=
# Chave secreta/service_role. Ignora RLS — SÓ no servidor, nunca com prefixo
# NEXT_PUBLIC_, senão vai parar no bundle do browser.
SUPABASE_SERVICE_ROLE_KEY=
